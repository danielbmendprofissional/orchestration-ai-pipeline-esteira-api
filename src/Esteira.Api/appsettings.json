{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "MassTransit": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  },
  "Autenticacao": {
    "RequerHttps": true,
    "ClaimUsuario": "preferred_username",
    "ClaimNome": "name"
  },
  "RabbitMQ": {
    "Ambiente": ""
  },
  "Cors": {
    "Origens": [ "http://localhost:4200" ]
  },
  "AllowedHosts": "*"
}
